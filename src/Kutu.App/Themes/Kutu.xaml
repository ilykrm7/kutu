<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="KutuBgColor">#1C1C1E</Color>
    <Color x:Key="KutuCardColor">#2C2C2E</Color>
    <Color x:Key="KutuCardHoverColor">#3A3A3C</Color>
    <Color x:Key="KutuLineColor">#38383A</Color>
    <Color x:Key="KutuTextColor">#F5F5F7</Color>
    <Color x:Key="KutuMutedColor">#98989D</Color>
    <Color x:Key="KutuFieldColor">#1C1C1E</Color>

    <SolidColorBrush x:Key="KutuBgBrush" Color="{StaticResource KutuBgColor}" />
    <SolidColorBrush x:Key="KutuCardBrush" Color="{StaticResource KutuCardColor}" />
    <SolidColorBrush x:Key="KutuCardHoverBrush" Color="{StaticResource KutuCardHoverColor}" />
    <SolidColorBrush x:Key="KutuLineBrush" Color="{StaticResource KutuLineColor}" />
    <SolidColorBrush x:Key="KutuTextBrush" Color="{StaticResource KutuTextColor}" />
    <SolidColorBrush x:Key="KutuMutedBrush" Color="{StaticResource KutuMutedColor}" />
    <SolidColorBrush x:Key="KutuFieldBrush" Color="{StaticResource KutuFieldColor}" />
    <SolidColorBrush x:Key="KutuAccentBrush" Color="#0A84FF" />

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#2C2C2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F5F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1C1C1E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0A84FF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KutuTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KutuCardHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
