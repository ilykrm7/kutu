<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="KutuBgColor">#070B14</Color>
    <Color x:Key="KutuCardColor">#141C2E</Color>
    <Color x:Key="KutuCardHoverColor">#1C2944</Color>
    <Color x:Key="KutuLineColor">#2A3A58</Color>
    <Color x:Key="KutuTextColor">#F4F7FB</Color>
    <Color x:Key="KutuMutedColor">#93A0B8</Color>
    <Color x:Key="KutuFieldColor">#0E1526</Color>

    <SolidColorBrush x:Key="KutuBgBrush" Color="{StaticResource KutuBgColor}" />
    <SolidColorBrush x:Key="KutuCardBrush" Color="{StaticResource KutuCardColor}" />
    <SolidColorBrush x:Key="KutuCardHoverBrush" Color="{StaticResource KutuCardHoverColor}" />
    <SolidColorBrush x:Key="KutuLineBrush" Color="{StaticResource KutuLineColor}" />
    <SolidColorBrush x:Key="KutuTextBrush" Color="{StaticResource KutuTextColor}" />
    <SolidColorBrush x:Key="KutuMutedBrush" Color="{StaticResource KutuMutedColor}" />
    <SolidColorBrush x:Key="KutuFieldBrush" Color="{StaticResource KutuFieldColor}" />
    <LinearGradientBrush x:Key="KutuAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#28A0F1" Offset="0" />
        <GradientStop Color="#4BDFB3" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141C2E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F4F7FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#101828" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F7FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#28A0F1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />

    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource KutuTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KutuCardHoverBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource KutuCardBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
