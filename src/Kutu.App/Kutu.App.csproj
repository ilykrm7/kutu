<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Kutu.App</RootNamespace>
    <AssemblyName>Kutu</AssemblyName>
    <ApplicationIcon>Assets\kutu.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Description>Kutu — Windows için küçük araçlar.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\kutu.ico" />
    <Resource Include="Assets\kutu.ico" />
    <Resource Include="Assets\kutu-mark.png" />
    <EmbeddedResource Include="Assets\kutu-mark.png" LogicalName="KutuMark.png" />
    <EmbeddedResource Include="shell\KutuShell.dll" LogicalName="KutuShell.dll" Condition="Exists('shell\KutuShell.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="UnifyFacadeReferences" AfterTargets="Publish">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../../build/UnifyRefs/UnifyRefs.csproj&quot; -c Release -- &quot;$(PublishDir)Kutu.exe&quot;" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Kutu.Core\Kutu.Core.csproj" />
    <ProjectReference Include="..\Kutu.Imaging\Kutu.Imaging.csproj" />
    <ProjectReference Include="..\Kutu.Sdk\Kutu.Sdk.csproj" />
    <ProjectReference Include="..\Tools\ClipboardHistory\Kutu.Tools.ClipboardHistory.csproj" />
    <ProjectReference Include="..\Tools\ColorPicker\Kutu.Tools.ColorPicker.csproj" />
    <ProjectReference Include="..\Tools\ImageConverter\Kutu.Tools.ImageConverter.csproj" />
    <ProjectReference Include="..\Tools\ImageResize\Kutu.Tools.ImageResize.csproj" />
    <ProjectReference Include="..\Tools\IpReputation\Kutu.Tools.IpReputation.csproj" />
    <ProjectReference Include="..\Tools\Screenshot\Kutu.Tools.Screenshot.csproj" />
    <ProjectReference Include="..\Tools\TextExpander\Kutu.Tools.TextExpander.csproj" />
    <ProjectReference Include="..\Tools\Translate\Kutu.Tools.Translate.csproj" />
    <ProjectReference Include="..\Tools\Upload\Kutu.Tools.Upload.csproj" />
    <ProjectReference Include="..\Tools\Whois\Kutu.Tools.Whois.csproj" />
  </ItemGroup>
</Project>
