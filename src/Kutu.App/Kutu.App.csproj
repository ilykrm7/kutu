<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Kutu.App</RootNamespace>
    <AssemblyName>Kutu</AssemblyName>
    <KutuIcon>Assets\kutu.ico</KutuIcon>
    <KutuManifest>app.manifest</KutuManifest>
    <ApplicationIcon />
    <NoWin32Manifest>true</NoWin32Manifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Company>Kerim Ekşi</Company>
    <Product>Kutu</Product>
    <Description>Kutu — Windows için küçük araçlar.</Description>
    <Copyright>Copyright © 2026 Kerim Ekşi</Copyright>
    <AssemblyVersion>1.1.5.0</AssemblyVersion>
    <FileVersion>1.1.5.0</FileVersion>
    <InformationalVersion>1.1.5</InformationalVersion>
    <Version>1.1.5</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets\kutu.ico" />
    <Resource Include="Assets\kutu.ico" />
    <Resource Include="Assets\kutu-mark.png" />
    <EmbeddedResource Include="Assets\kutu-mark.png" LogicalName="KutuMark.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="GenerateWin32Resources" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <Win32Resource>$(IntermediateOutputPath)kutu.win32.res</Win32Resource>
    </PropertyGroup>
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../../build/Win32Res/Win32Res.csproj&quot; -c Release -- &quot;$(Win32Resource)&quot; &quot;$(MSBuildThisFileDirectory)$(KutuManifest)&quot; &quot;$(MSBuildThisFileDirectory)$(KutuIcon)&quot;" />
  </Target>
  <Target Name="UnifyFacadeReferences" AfterTargets="Publish">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)../../build/UnifyRefs/UnifyRefs.csproj&quot; -c Release -- &quot;$(PublishDir)Kutu.exe&quot;" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\Kutu.Core\Kutu.Core.csproj" />
    <ProjectReference Include="..\Kutu.Imaging\Kutu.Imaging.csproj" />
    <ProjectReference Include="..\Kutu.Sdk\Kutu.Sdk.csproj" />
    <ProjectReference Include="..\Tools\ClipboardHistory\Kutu.Tools.ClipboardHistory.csproj" />
    <ProjectReference Include="..\Tools\ColorPicker\Kutu.Tools.ColorPicker.csproj" />
    <ProjectReference Include="..\Tools\Digest\Kutu.Tools.Digest.csproj" />
    <ProjectReference Include="..\Tools\Fonts\Kutu.Tools.Fonts.csproj" />
    <ProjectReference Include="..\Tools\ImageConverter\Kutu.Tools.ImageConverter.csproj" />
    <ProjectReference Include="..\Tools\ImageResize\Kutu.Tools.ImageResize.csproj" />
    <ProjectReference Include="..\Tools\Matte\Kutu.Tools.Matte.csproj" />
    <ProjectReference Include="..\Tools\IpReputation\Kutu.Tools.IpReputation.csproj" />
    <ProjectReference Include="..\Tools\Screenshot\Kutu.Tools.Screenshot.csproj" />
    <ProjectReference Include="..\Tools\TextExpander\Kutu.Tools.TextExpander.csproj" />
    <ProjectReference Include="..\Tools\Translate\Kutu.Tools.Translate.csproj" />
    <ProjectReference Include="..\Tools\Upload\Kutu.Tools.Upload.csproj" />
    <ProjectReference Include="..\Tools\Uuid\Kutu.Tools.Uuid.csproj" />
    <ProjectReference Include="..\Tools\BulkIp\Kutu.Tools.BulkIp.csproj" />
    <ProjectReference Include="..\Tools\NetProbe\Kutu.Tools.NetProbe.csproj" />
    <ProjectReference Include="..\Tools\Ocr\Kutu.Tools.Ocr.csproj" />
    <ProjectReference Include="..\Tools\Password\Kutu.Tools.Password.csproj" />
    <ProjectReference Include="..\Tools\Qr\Kutu.Tools.Qr.csproj" />
    <ProjectReference Include="..\Tools\ScreenRecord\Kutu.Tools.ScreenRecord.csproj" />
    <ProjectReference Include="..\Tools\ScreenTranslate\Kutu.Tools.ScreenTranslate.csproj" />
    <ProjectReference Include="..\Tools\SslCheck\Kutu.Tools.SslCheck.csproj" />
    <ProjectReference Include="..\Tools\VideoDownload\Kutu.Tools.VideoDownload.csproj" />
    <ProjectReference Include="..\Tools\Whois\Kutu.Tools.Whois.csproj" />
  </ItemGroup>
</Project>
