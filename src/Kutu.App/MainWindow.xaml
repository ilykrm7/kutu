<ui:FluentWindow x:Class="Kutu.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Kutu"
                 Width="1180"
                 Height="780"
                 MinWidth="980"
                 MinHeight="640"
                 Background="#070B14"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="Assets/kutu.ico"
                 FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Background="#070B14">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Kutu" Background="#070B14" Foreground="#F4F7FB" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#B80B1220" BorderBrush="{StaticResource KutuLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,8,16,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock x:Name="FooterLink" Margin="14,8,0,0" Foreground="{StaticResource KutuMutedBrush}" FontSize="12"
                                   Cursor="Hand" TextDecorations="Underline" />
                        <TextBlock x:Name="VersionText" Margin="14,4,0,0" Foreground="{StaticResource KutuMutedBrush}" FontSize="11" Opacity="0.8" />
                    </StackPanel>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,8,8,22">
                            <Image Width="40" Height="40" Source="/Assets/kutu-mark.png" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Kutu" Margin="12,0,0,0" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource KutuTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="DashboardButton" Style="{StaticResource NavButton}" Click="Dashboard_Click" />
                        <Button x:Name="FavoritesButton" Style="{StaticResource NavButton}" Click="Favorites_Click" />
                        <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Click="Settings_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl x:Name="Pages" />
                <Border x:Name="ToastCard" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Background="#F2141C2E" BorderBrush="{StaticResource KutuAccentBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="16,10" Visibility="Collapsed">
                    <TextBlock x:Name="ToastText" Foreground="{StaticResource KutuTextBrush}" FontSize="13" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
