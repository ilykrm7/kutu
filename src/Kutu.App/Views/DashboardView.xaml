<UserControl x:Class="Kutu.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,28">
        <StackPanel>
            <TextBlock x:Name="Greeting" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource KutuTextBrush}" />
            <TextBlock x:Name="Tagline" Margin="0,4,0,18" FontSize="14" Foreground="{StaticResource KutuMutedBrush}" />
            <ui:TextBox x:Name="SearchBox" Margin="0,0,0,18" FontSize="15" />
            <WrapPanel x:Name="Cards" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
