<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Kutu.Tools.Ocr</RootNamespace>
    <!-- The SDK contracts package also references the NuGet WinRT facade. Use the Framework copy instead so the two are not both imported. -->
    <DoNotReferenceWinRT>true</DoNotReferenceWinRT>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Kutu.Sdk\Kutu.Sdk.csproj" />
    <ProjectReference Include="..\Screenshot\Kutu.Tools.Screenshot.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2428" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Runtime.WindowsRuntime" Version="4.6.0">
      <ExcludeAssets>all</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Runtime.WindowsRuntime.UI.Xaml" Version="4.6.0">
      <ExcludeAssets>all</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Windows.Foundation.FoundationContract">
      <HintPath>$(PkgMicrosoft_Windows_SDK_Contracts)\ref\netstandard2.0\Windows.Foundation.FoundationContract.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="Windows.Foundation.UniversalApiContract">
      <HintPath>$(PkgMicrosoft_Windows_SDK_Contracts)\ref\netstandard2.0\Windows.Foundation.UniversalApiContract.winmd</HintPath>
      <IsWinMDFile>true</IsWinMDFile>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.WindowsRuntime" Condition="Exists('$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll')">
      <HintPath>$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireWinRt" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\System.Runtime.WindowsRuntime.dll')" Text="System.Runtime.WindowsRuntime.dll was not found. Windows OCR needs the .NET Framework 4.8 runtime." />
    <Error Condition="!Exists('$(PkgMicrosoft_Windows_SDK_Contracts)\ref\netstandard2.0\Windows.Foundation.UniversalApiContract.winmd')" Text="Windows.Foundation.UniversalApiContract.winmd was not restored." />
  </Target>
</Project>
